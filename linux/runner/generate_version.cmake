if(NOT DEFINED PACKAGE_VERSION OR PACKAGE_VERSION STREQUAL "")
  set(PACKAGE_VERSION "0.2.0")
endif()

set(COMMIT_COUNT "0")
if(DEFINED PROJECT_DIR AND EXISTS "${PROJECT_DIR}")
  execute_process(
    COMMAND git rev-list --count HEAD
    WORKING_DIRECTORY "${PROJECT_DIR}"
    RESULT_VARIABLE COUNT_RESULT
    OUTPUT_VARIABLE RAW_COUNT
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
  )
  if(COUNT_RESULT EQUAL 0 AND RAW_COUNT MATCHES "^[0-9]+$")
    set(COMMIT_COUNT "${RAW_COUNT}")
  endif()
endif()

set(COMMIT_HASH "unknown")
if(DEFINED PROJECT_DIR AND EXISTS "${PROJECT_DIR}")
  execute_process(
    COMMAND git rev-parse --short HEAD
    WORKING_DIRECTORY "${PROJECT_DIR}"
    RESULT_VARIABLE HASH_RESULT
    OUTPUT_VARIABLE RAW_HASH
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
  )
  if(HASH_RESULT EQUAL 0 AND RAW_HASH MATCHES "^[0-9a-fA-F]+$")
    set(COMMIT_HASH "${RAW_HASH}")
  endif()
endif()

set(DIRTY_SUFFIX "")
if(DEFINED PROJECT_DIR AND EXISTS "${PROJECT_DIR}")
  execute_process(
    COMMAND git status --porcelain
    WORKING_DIRECTORY "${PROJECT_DIR}"
    RESULT_VARIABLE STATUS_RESULT
    OUTPUT_VARIABLE RAW_STATUS
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
  )
  if(STATUS_RESULT EQUAL 0 AND NOT RAW_STATUS STREQUAL "")
    set(DIRTY_SUFFIX ".dev")
  endif()
endif()

set(FULL_VERSION "v${PACKAGE_VERSION}+${COMMIT_COUNT}.${COMMIT_HASH}${DIRTY_SUFFIX}")
set(HEADER_CONTENT "#ifndef TIERTASK_GENERATED_VERSION_H_\n#define TIERTASK_GENERATED_VERSION_H_\n\n#define TIERTASK_FULL_VERSION \"${FULL_VERSION}\"\n\n#endif  // TIERTASK_GENERATED_VERSION_H_\n")

set(EXISTING_CONTENT "")
if(EXISTS "${OUTPUT_HEADER}")
  file(READ "${OUTPUT_HEADER}" EXISTING_CONTENT)
endif()

if(NOT EXISTING_CONTENT STREQUAL HEADER_CONTENT)
  file(WRITE "${OUTPUT_HEADER}" "${HEADER_CONTENT}")
endif()
