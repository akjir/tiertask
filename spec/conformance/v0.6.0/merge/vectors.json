            {
              "id": "9aBc2D0eF4",
              "deletedAt": "2026-11-02T12:00:01Z",
              "completionsCheckpoint": 2
            }
          ]
        },
        "dependentTask": {
          "id": "8jKaCdOkD2",
          "modified": "2026-12-02T12:00:01Z",
          "blocked": [
            {
              "targetId": "9aBc2D0eF4",
