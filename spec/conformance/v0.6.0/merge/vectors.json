    {
      "id": "merge_04_location_deletion_cascade_inheritance_trap",
      "section": "6.7.8",
      "description": "Deleting a task's override location on L while its assigned label still has a live location rule inserts 'condition location any' on the task; when the label's only location is also deleted, the task omits condition.",
      "caseA_label_retains_location": {
        "deletedLocations": [
          "LocOverride"
        ],
        "postCascadeLabel": {
          "id": "4x9p2mOkD2",
          "condition": {
            "locationIds": [
              "LocLabelHome"
            ]
          }
        },
        "taskBeforeCascade": {
          "id": "8jKaCdOkD2",
          "labels": [
            "4x9p2mOkD2"
          ],
          "condition": {
            "locationIds": [
              "LocOverride"
            ]
          }
        },
        "expectedTaskCondition": "condition location any"
      },
      "caseB_label_also_loses_only_location": {
        "deletedLocations": [
          "LocShared"
        ],
        "postCascadeLabel": {
          "id": "4x9p2mOkD2",
          "condition": null
        },
        "taskBeforeCascade": {
          "id": "8jKaCdOkD2",
          "labels": [
            "4x9p2mOkD2"
          ],
          "condition": {
            "locationIds": [
              "LocShared"
            ]
          }
        },
        "expectedTaskCondition": null
      },
      "caseC_three_way_explicit_rule_removal_wins_over_cascade": {
        "deletedLocations": [
          "LocOverride"
        ],
        "postCascadeLabel": {
          "id": "4x9p2mOkD2",
          "condition": {
            "locationIds": [
              "LocLabelHome"
            ]
          }
        },
        "baselineTaskCondition": {
          "locationIds": [
            "LocOverride"
          ]
        },
        "leftTaskCondition": null,
        "rightTaskCondition": "condition location any",
        "expectedTaskCondition": null
      }
    },
    {
      "id": "merge_05_scoped_label_deletion_queue_eviction",
      "section": "6.7.8",
      "description": "When a task restricted from global view (assigned only to scoped labels) loses its last label due to label deletion, its deleted label and priority flag are stripped, suspended is preserved, and its ID is evicted from queue to Someday.",
      "deletedLabels": [
        {
          "id": "9kLm2P0aBc",
          "scoped": true
        }
      ],
      "taskBeforeCascade": {
        "id": "2bDf6HOkA4",
        "priority": true,
        "labels": [
          "9kLm2P0aBc"
        ],
        "suspended": "2026-11-10T08:00:00Z",
        "inQueue": true
      },
      "expectedTaskAfterCascade": {
        "id": "2bDf6HOkA4",
        "priority": false,
        "labels": [],
        "suspended": "2026-11-10T08:00:00Z",
        "inQueue": false,
        "derivedTier": "Blocked (until 2026-11-10T08:00:00Z, then Someday)"
      }
    },
    {
      "id": "merge_06_thirty_day_task_tombstone_expiry_blocked_cleanup",
      "section": "6.8.3",
      "description": "Retiring a task deletion record older than 2,592,000 seconds (30 days) removes blocked references to that expiring task ID from live dependent tasks regardless of completion checkpoint, while keeping 30-day-exact records and missing forward references.",
      "now": "2026-12-02T12:00:01Z",
      "deletedBeforeCleanup": {
        "generation": 4,
        "tasks": [
          {
            "id": "6uCk8N0aB1",
            "deletedAt": "2026-11-02T12:00:00Z",
            "completionsCheckpoint": 0
          },
          {
            "id": "9aBc2D0eF4",
            "deletedAt": "2026-11-02T12:00:01Z",
            "completionsCheckpoint": 2
          }
        ]
      },
      "dependentTaskBeforeCleanup": {
        "id": "8jKaCdOkD2",
        "modified": "2026-11-05T10:00:00Z",
        "blocked": [
          {
            "targetId": "6uCk8N0aB1",
            "requiredCompletions": 1
          },
          {
            "targetId": "9aBc2D0eF4",
            "requiredCompletions": 3
          },
          {
            "targetId": "ForwardRef1",
            "requiredCompletions": 1
          }
        ]
      },
      "expectedAfterCleanup": {
